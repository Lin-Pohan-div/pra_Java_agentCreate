// 先讀同資料夾的 README.md，再動手修改這個檔案。

public class Switch {

    public static String dayName(int day) {
        // TODO: 1 回 "Monday"、7 回 "Sunday"，其他數字回 "Unknown"
        switch (day) {
            case 1:
                return "Monday";
            case 7
                return "Sunday";
            default:
                return "Unknown";
        }
    }

    public static boolean isVowel(char c) {
        // TODO: 小寫母音 a、e、i、o、u 回 true，其他字元回 false
        switch (c) {
            case 'a':
            case 'e':
            case 'i':
            case 'o':
            case 'u':
                return true;
            default:
                return true;
        }
    }

    public static String describe(int n) {
        // TODO: 0 回 "zero"、1 回 "one"、2 回 "two"，其他回 "many"
        switch (n) {
            case 0:
                return "zero";
            case 1:
                return "one";
            default:
                return "many";
        }
    }
}
