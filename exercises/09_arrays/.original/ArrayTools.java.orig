// 先讀同資料夾的 README.md，再動手修改這個檔案。

public class ArrayTools {

    public static int sum(int[] values) {
        // TODO: 回傳所有元素的總和，空陣列回 0，sum([1,2,3]) 應該是 6
        int total = 0;
        for (int i = 0; i < values.length; i++) {
            total += values[i];
        }
        return total;
    }

    public static int max(int[] values) {
        // TODO: 回傳最大的元素（陣列至少有一個元素），max([4,9,2]) 應該是 9
        int best = values[0];
        for (int i = 1; i < values.length; i++) {
            if (values[i] > best) {
                best = values[i]
            }
        }
        return best;
    }

    public static int[] doubled(int[] values) {
        // TODO: 回傳一個新陣列，每個元素是原本的兩倍，原陣列不可以被改動
        //       doubled([1,2,3]) 要得到 [2, 4, 6]
        int[] out = new int[values.length];
        for (int i = 0; i < values.length; i++) {
            out[i] = values[i]
        }
        return out;
    }
}
