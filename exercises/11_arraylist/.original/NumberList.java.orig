// 先讀同資料夾的 README.md，再動手修改這個檔案。

import java.util.ArrayList;

public class NumberList {

    public static ArrayList<Integer> ofRange(int from, int to) {
        // TODO: 產生 from 到 to（含頭含尾），ofRange(1, 3) 要得到 [1, 2, 3]
        ArrayList<Integer> out = new ArrayList<>();
        for (int i = from; i <= to; i++) {
            out.add(i);
        }
        return out;
    }

    public static int total(ArrayList<Integer> numbers) {
        // TODO: 回傳清單所有元素的總和，total([1,2,3]) 應該是 6
        int sum = 0;
        for (int n : numbers) {
            sum += n
        }
        return sum;
    }

    public static ArrayList<Integer> doubled(ArrayList<Integer> numbers) {
        // TODO: 每個元素乘以 2 後回傳新清單，doubled([1,2]) 要得到 [2, 4]
        ArrayList<Integer> out = new ArrayList<>();
        for (int n : numbers) {
            out.add(n * 2)
        }
        return out;
    }

    public static ArrayList<Integer> evens(ArrayList<Integer> numbers) {
        // TODO: 只留下偶數，evens([1,2,3,4]) 要得到 [2, 4]
        return numbers;
    }
}
